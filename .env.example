# Banco de dados (SQLite em dev; troque para Postgres em produção)
DATABASE_URL="file:./dev.db"

# Provider de WhatsApp: console | twilio | meta
WHATSAPP_PROVIDER="console"

# Twilio (https://www.twilio.com/docs/whatsapp)
TWILIO_ACCOUNT_SID=""
TWILIO_AUTH_TOKEN=""
TWILIO_WHATSAPP_FROM="whatsapp:+14155238886"

# Meta WhatsApp Cloud API (https://developers.facebook.com/docs/whatsapp/cloud-api)
META_WHATSAPP_TOKEN=""
META_WHATSAPP_PHONE_NUMBER_ID=""

# Distância mínima (em metros) somada ao raio para considerar saída da geofence (histerese)
GEOFENCE_EXIT_BUFFER_M="100"
