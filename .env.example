DATABASE_URL="postgresql://USER:PASSWORD@HOST/neondb?sslmode=require"
ADMIN_PASSWORD="generate-a-long-unique-password"
SESSION_SECRET="generate-at-least-32-random-bytes"
# disabled: records UNCONFIGURED and never sends a real message.
WHATSAPP_PROVIDER="disabled"
META_WHATSAPP_TOKEN=""
META_WHATSAPP_PHONE_NUMBER_ID=""
META_WHATSAPP_TEMPLATE=""
# Set a currently supported Graph API version for your Meta app, e.g. vXX.X.
META_GRAPH_VERSION=""
META_TEMPLATE_LANGUAGE="pt_BR"
# Only needed when packaging the native application:
CAPACITOR_SERVER_URL="https://your-deployment.vercel.app"
# Server-only key for destination geocoding and truck route estimates.
OPENROUTESERVICE_API_KEY=""
ROUTE_OPERATIONAL_MARGIN_HOURS="4"
GLOBALSAT_BASE_URL="https://apis.rastreioglobalsat.com"
# Portal documentation login only; not used by OAuth API requests.
GLOBALSAT_USERNAME="example-user"
GLOBALSAT_PASSWORD="example-password"
# Server-only credentials for GlobalSAT GPS position synchronization.
GLOBALSAT_CLIENT_ID=""
GLOBALSAT_CLIENT_SECRET=""
# At least 32 random characters. Shared only with the scheduled sync caller.
GLOBALSAT_SYNC_SECRET=""
