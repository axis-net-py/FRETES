generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Client {
  id         String      @id @default(cuid())
  name       String
  whatsapp   String
  consent    Boolean     @default(false)
  createdAt  DateTime    @default(now())
  containers Container[]
}

model Driver {
  id         String      @id @default(cuid())
  name       String
  phone      String
  plate      String      @default("")
  createdAt  DateTime    @default(now())
  containers Container[]
  positions  Position[]
}

model Geofence {
  id        String   @id @default(cuid())
  name      String
  latitude  Float
  longitude Float
  radiusM   Int      @default(300)
  status    String
  active    Boolean  @default(true)
  createdAt DateTime @default(now())
  events    GeofenceEvent[]
}

model Container {
  id         String   @id @default(cuid())
  code       String   @unique
  status     String   @default("EM_TRANSITO")
  origin     String?
  destination String?
  crt String?
  micDta String?
  truckPlate String?
  trailerPlate String?
  freightValue String?
  freightCurrency String?
  seal String?
  transitHours Int?
  gateEnteredAt DateTime?
  exitCandidateAt DateTime?
  lastGeofenceFixAt DateTime?
  departedAt DateTime?
  estimatedArrivalAt DateTime?
  customerTrackingHash String? @unique
  customerTrackingExpiresAt DateTime?
  document TripDocument?
  clientId   String
  driverId   String?
  geofenceId String?
  trackingTokenHash String? @unique
  trackingExpiresAt DateTime?
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  client        Client          @relation(fields: [clientId], references: [id])
  driver        Driver?         @relation(fields: [driverId], references: [id])
  events        GeofenceEvent[]
  notifications Notification[]
}

model Position {
  id          String   @id @default(cuid())
  driverId    String
  containerId String?
  latitude    Float
  longitude   Float
  accuracyM   Float?
  source      String   @default("DEVICE")
  externalId  String?
  recordedAt  DateTime @default(now())

  driver Driver @relation(fields: [driverId], references: [id])

  @@index([driverId, recordedAt])
  @@unique([source, externalId])
}

model IntegrationState {
  provider        String   @id
  cursor          BigInt?
  lockedUntil     DateTime?
  lastStartedAt   DateTime?
  lastSucceededAt DateTime?
  lastError       String?
  lastSummary     Json?
  updatedAt       DateTime @updatedAt
}

model GeofenceEvent {
  id          String   @id @default(cuid())
  geofenceId  String
  containerId String
  type        String
  latitude    Float
  longitude   Float
  createdAt   DateTime @default(now())

  geofence  Geofence  @relation(fields: [geofenceId], references: [id])
  container Container @relation(fields: [containerId], references: [id])

  @@index([geofenceId, containerId, createdAt])
  @@unique([geofenceId, containerId, type])
}

model Notification {
  id          String   @id @default(cuid())
  containerId String
  to          String
  body        String
  channel     String   @default("whatsapp")
  kind        String   @default("STATUS")
  provider    String
  status      String
  error       String?
  providerRef String?
  parameters  String       @default("[]")
  attempts    Int          @default(0)
  updatedAt   DateTime     @updatedAt
  createdAt   DateTime @default(now())

  container Container @relation(fields: [containerId], references: [id])
}

model LoginAttempt {
  key String @id
  count Int @default(1)
  expiresAt DateTime
}

model TripDocument {
  id String @id @default(cuid())
  filename String
  mimeType String
  content Bytes
  sha256 String @unique
  extracted Json
  containerId String? @unique
  container Container? @relation(fields: [containerId], references: [id])
  createdAt DateTime @default(now())
}
