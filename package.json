{
  "name": "axis-fretes",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint src --ext .ts,.tsx",
    "typecheck": "tsc --noEmit",
    "db:push": "prisma db push",
    "postinstall": "prisma generate",
    "db:deploy": "prisma migrate deploy",
    "test": "node --env-file-if-exists=.env --import tsx --test tests/geofence.test.ts tests/documents.test.ts tests/drivers.test.ts tests/route-estimate.test.ts tests/globalsat-client.test.ts tests/globalsat-sync.test.ts tests/globalsat-routes.test.ts",
    "test:integration": "node --env-file-if-exists=.env.test --import tsx --test --test-concurrency=1 tests/integration.test.ts tests/import-integration.test.ts"
  },
  "dependencies": {
    "@capacitor/core": "^6.2.2",
    "@capacitor/geolocation": "^6.1.1",
    "@phosphor-icons/react": "^2.1.10",
    "@prisma/client": "^5.22.0",
    "jose": "^6.2.12",
    "next": "^15.5.25",
    "prisma": "^5.22.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@capacitor/android": "^6.2.2",
    "@capacitor/cli": "^6.2.2",
    "@capacitor/ios": "^6.2.2",
    "@types/node": "^20",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "eslint": "^8",
    "eslint-config-next": "^15.5.25",
    "postcss": "^8.5.28",
    "prettier": "^3.9.6",
    "tailwindcss": "^3.4.1",
    "tsx": "^4.23.13",
    "typescript": "^5"
  },
  "overrides": {
    "postcss": "^8.5.28",
    "tar": "^7.5.22"
  }
}
